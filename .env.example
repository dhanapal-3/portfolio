MAIL_API_PORT=4301
# Browser origin allowed to POST /api/contact (required in production)
FRONTEND_ORIGIN=http://localhost:4200
# NODE_ENV=production

# Gmail: use an App Password (16 chars, no spaces) — https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourgmailaccount@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=yourgmailaccount@gmail.com

# Comma-separated recipients
CONTACT_TARGET_EMAIL=yourgmailaccount@gmail.com
